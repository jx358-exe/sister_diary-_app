MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=sister_diary
CORS_ORIGINS=http://127.0.0.1:8766,http://localhost:8766
AUTH_SECRET=replace-with-a-long-random-value-before-deployment

# Email one-time codes (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SMS one-time codes (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# DeepSeek V4.1 Flash. Keep the API key on the backend only.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
